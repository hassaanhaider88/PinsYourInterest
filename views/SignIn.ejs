<% include ./partials/header.ejs %>
  <section class="Parent w-full min-h-screen pt-2 flex flex-col justify-center items-center">

    <div class="Main my-3 bg-white min-h-[120vh] bg-white md:py-10 md:px-16 py-1 sm:px-4 px-0 rounded-[50px] shadow-lg">
        <span class="fixed top-5 hover:scale-95 duration-200 transition-all  w-12 h-12 flex justify-center items-center cursor-pointer left-5 bg-[#E60023] rounded-full">
        <a href="/">
          <svg stroke="white" fill="white" stroke-width="0" viewBox="0 0 448 512" height="25px" width="25px"
          xmlns="http://www.w3.org/2000/svg" class="copy-svg-injected">
          <path
            d="M257.5 445.1l-22.2 22.2c-9.4 9.4-24.6 9.4-33.9 0L7 273c-9.4-9.4-9.4-24.6 0-33.9L201.4 44.7c9.4-9.4 24.6-9.4 33.9 0l22.2 22.2c9.5 9.5 9.3 25-.4 34.3L136.6 216H424c13.3 0 24 10.7 24 24v32c0 13.3-10.7 24-24 24H136.6l120.5 114.8c9.8 9.3 10 24.8.4 34.3z">
          </path>
        </svg>
        </a>
      </span>
      <div class="relative  px-5 text-center h-[120vh] rounded-[20px]  RegisterContainer">
        <img class="inline mt-1 pb-6" src="../images/Logo.svg" alt="">
        <h1 class="text-3xl font-semibold">Welcome to PinsYourInterest</h1>
        <p class="font-[400]">Find new ideas to try</p>
        <form action="/user/create-user" method="post" class="form-group">
          <label class="text-left -mb-5 block" for="Email">Email</label> <br>
          <input type="email"
            class="form-control border border-2 border-gray-400 w-full rounded-[22px] focus:outline-[#E60023] py-3 pl-2"
            name='email' required placeholder="Email"></input> <br />
          <label class="text-left -mb-5 block" for="Name">Name</label> <br>
          <input type="text"
            class="form-control border border-2 border-gray-400 w-full rounded-[22px] focus:outline-[#E60023] py-3 pl-2"
            name="user_name" required placeholder="Username"></input> <br />
          <label class="text-left -mb-5 block" for="Password">Password</label> <br>
          <input type="password"
            class="form-control border border-2 border-gray-400 w-full rounded-[22px] focus:outline-[#E60023] py-3 pl-2"
            name="password" required placeholder="Create Password"></input> <br />
          <input
            class="form-control bg-[#E60023] mt-2 mb-2 font-[600] hover:bg-red-600 duration-500 cursor-pointer text-white w-full rounded-[22px] py-2"
            type='submit' value="Continue" />
        </form>
        <h4 class="font-semibold my-2">OR</h4>
        <div>
        </div>
        <div
          class=" mt-2 mb-2 font-[600] hover:bg-white border border-2 border-gray-200 bg-gray-100 shadow-md hover:shodow-lg cursor-pointer text-black w-full rounded-[22px] py-1 GoogleBtn">
          <button class="google-btn">
            <p class="inline">Login with Google</p>
            <img class="inline ml-10" src="../images/Google.svg" alt="">
          </button>
        </div>




        <div class="my-5 text-center text-[14px]">
          <p class="text-[14px]">By continuing, you agree to Pinterest's </p>
          <b class="font-[700]">Terms of Service</b>
          <p class="text-[14px] inline">and acknowledge you've read </p> <br> our
          <b>Privacy Policy. Notice at collection.</b>
        </div>
        <p class="my-5 text-center text-[13px]"> Already a member ? <a href="/user/login">Log in</a></p>


      </div>
    </div>


  </section>
  </body>

  </html>